{
  "name": "labuco-storefront",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "next dev -p 3001 --turbopack",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:locales": "tsx scripts/check-locale-parity.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:up": "docker compose -f e2e-backend/docker-compose.yml up -d --wait && ./scripts/e2e/bootstrap-spree.sh",
    "e2e:down": "docker compose -f e2e-backend/docker-compose.yml down -v"
  },
  "dependencies": {
    "@adyen/adyen-web": "^6.43.0",
    "@next/third-parties": "^16.3.1",
    "@paypal/react-paypal-js": "^10.3.0",
    "@sentry/nextjs": "^10.70.0",
    "@spree/sdk": "^1.2.1",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "@swc/helpers": "^0.5.21",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "react-email": "^6.9.2",
    "react-svg-credit-card-payment-icons": "^6.0.4",
    "resend": "^6.20.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "swiper": "^14.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "postcss": "^8.5.10",
    "mute-stream": "^3.0.0",
    "sharp": "^0.35.3",
    "@hono/node-server": "^2.0.5"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^10.2.1",
      "postcss": "^8.5.10",
      "mute-stream": "^3.0.0",
      "sharp": "^0.35.3",
      "@hono/node-server": "^2.0.5"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "esbuild",
      "lefthook"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@spree/cli": "^2.4.9",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^7",
    "vitest": "^4.1.10"
  }
}
