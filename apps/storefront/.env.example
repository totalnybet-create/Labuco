# Commerce provider
# - catalog: checked-in Labuco catalog, no transactional backend required
# - spree: Spree Store API
# If omitted, the app uses Spree only when both SPREE variables below exist;
# otherwise it safely falls back to catalog mode.
COMMERCE_PROVIDER=catalog
# Optional override for the repository-level catalog JSON path.
# LABUCO_CATALOG_PATH=/absolute/path/to/data/labuco_catalog.json

# Spree API Configuration (server-side only - not exposed to browser)
SPREE_API_URL=http://localhost:3000
SPREE_PUBLISHABLE_KEY=your_publishable_api_key

# Newsletter persistence (Supabase, server-side route)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Wholesale B2B portal (opt-in addon)
# SPREE_WHOLESALE_CHANNEL=wholesale
# SPREE_WHOLESALE_PUBLISHABLE_KEY=

# Labuco store defaults — Poland / Polish
NEXT_PUBLIC_DEFAULT_COUNTRY=pl
NEXT_PUBLIC_DEFAULT_LOCALE=pl
NEXT_PUBLIC_SITE_URL=https://labuco.pl
NEXT_PUBLIC_STORE_NAME=Labuco
NEXT_PUBLIC_STORE_DESCRIPTION=Sprzęt, nawozy, oświetlenie, wentylacja, pomiary i akcesoria do uprawy indoor.

# Store SEO settings
STORE_SEO_TITLE=Labuco — sklep do uprawy indoor
STORE_META_DESCRIPTION=Sprzęt, nawozy, oświetlenie, wentylacja, pomiary i akcesoria do uprawy indoor w konkurencyjnych cenach.
STORE_META_KEYWORDS=uprawa indoor,growbox,nawozy do roślin,oświetlenie do roślin,wentylacja,pomiary pH

# Store social / Organization JSON-LD (optional)
STORE_TWITTER=
STORE_FACEBOOK=
STORE_INSTAGRAM=
STORE_LOGO_URL=
STORE_SUPPORT_EMAIL=

# Google Tag Manager (leave empty to disable)
GTM_ID=

# Transactional Emails via Webhooks (optional)
SPREE_WEBHOOK_SECRET=your_webhook_endpoint_secret_key
RESEND_API_KEY=
EMAIL_FROM=Labuco <zamowienia@labuco.pl>

# Stripe (optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# PayPal browser SDK client ID. Use the same PayPal app as PAYPAL_CLIENT_ID on
# the Rails backend. HotPay needs no browser secret/client ID: its transaction
# URL is created server-side and only that URL is exposed to the storefront.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Sentry Error Tracking (optional)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-auth-token
SENTRY_SEND_DEFAULT_PII=false
NEXT_PUBLIC_SENTRY_SEND_DEFAULT_PII=false
