#!/bin/bash -e

# If running the Rails server, prepare the database first. Once migrations are
# complete, configure the LABUCO Stripe gateway from deployment secrets. The
# rake task is idempotent and safely skips itself when both keys are absent.
if [[ "$*" == *"./bin/rails server"* ]]; then
  ./bin/rails db:prepare
  ./bin/rails labuco:stripe:configure
fi

exec "${@}"
