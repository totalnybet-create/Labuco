#!/bin/bash -e

# If running the Rails server, prepare the database and idempotently bootstrap
# payment methods from deployment secrets. Tasks safely skip providers whose
# credentials have not been configured yet.
if [[ "$*" == *"./bin/rails server"* ]]; then
  ./bin/rails db:prepare
  ./bin/rails labuco:stripe:configure
  ./bin/rails labuco:payments:configure
fi

exec "${@}"
