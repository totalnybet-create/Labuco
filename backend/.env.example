# Required
SECRET_KEY_BASE=change-me-generate-with-bin-rails-secret

# Database — use DATABASE_URL for production-style runs.
# DATABASE_URL=postgres://postgres@localhost:5432/spree_production

# Stripe payments — optional while Stripe onboarding is inactive.
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# HotPay — configure both after the LABUCO service is accepted in HotPay.
# HOTPAY_SECRET=
# HOTPAY_NOTIFICATION_PASSWORD=
# HOTPAY_ENFORCE_IP_WHITELIST=true
# Notification URL: https://<backend-host>/payments/hotpay/webhook

# PayPal — optional second online method.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_SECRET=
# PAYPAL_TEST_MODE=true

# Manual bank transfer. This value is public by design because it is displayed
# to customers who choose bank transfer.
LABUCO_BANK_ACCOUNT=PL88 1050 1748 1000 0098 5745 4228

# Web Server
PORT=3000
# RAILS_MAX_THREADS=3
# WEB_CONCURRENCY=1

# Background jobs (Solid Queue)
# SOLID_QUEUE_IN_PUMA=true
# JOB_THREADS=3
# SPREE_IMPORT_JOB_CONCURRENCY=2

# Job dashboard (/jobs) HTTP Basic auth
# MISSION_CONTROL_USER=
# MISSION_CONTROL_PASSWORD=

# Docker host ports
# SPREE_PORT=3000
# SPREE_DB_PORT=5433
# SPREE_MEILISEARCH_PORT=7700

# SSL
# RAILS_FORCE_SSL=false
# RAILS_ASSUME_SSL=false

# Public host (production)
# RAILS_HOST=store.example.com

# Optional CDN
# CDN_HOST=cdn.example.com

# Email (SMTP)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=store@example.com

# File Storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET=spree-production

# Cloudflare R2
# CLOUDFLARE_ENDPOINT=
# CLOUDFLARE_ACCESS_KEY_ID=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKET=spree-production

# Error Tracking
# SENTRY_DSN=

# Application
# RAILS_ENV=production
# RAILS_LOG_LEVEL=info

# Search
# MEILISEARCH_URL=
# MEILISEARCH_API_KEY=

# Spree core development
# SPREE_PATH=../spree
